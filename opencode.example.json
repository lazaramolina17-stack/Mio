    },
    "architect": {
      "description": "Arquitecto de software para dise\u00f1o de sistemas y decisiones t\u00e9cnicas.",
      "mode": "subagent",
      "color": "#3B82F6",
      "model": "llama-3.3-70b-versatile",
      "permission": {
        "edit": "deny",
        "bash": "ask"
      }
    },
    "cli": {
      "description": "Especialista en herramientas CLI, scripts y automatizaci\u00f3n.",
      "mode": "subagent",
      "color": "#14B8A6",
